{
  "name": "mexicoapi-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "TZ=America/Mexico_City TZ_ESPERADA=America/Mexico_City vitest run --coverage",
    "test:tz": "TZ=UTC TZ_ESPERADA=UTC vitest run --project '!core'",
    "build": "pnpm -r build",
    "datos:verificar": "pnpm --filter @mexicoapi/pipeline verificar",
    "datos:curar": "pnpm --filter @mexicoapi/pipeline curar",
    "verify": "./scripts/verify.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
