{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Nombre solo para uso local: el despliegue genera wrangler.<entorno>.json con el nombre, el KV
  // y el límite de cada entorno, así que un `wrangler deploy` con este archivo no toca producción.
  "name": "mexicoapi-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1", "/v1/*"],
    // Fuera de /v1, lo que no es un asset lo responde 404.html sin invocar al Worker.
    "not_found_handling": "404-page"
  },
  // No se guardan consultas ni se envían métricas de uso de wrangler.
  "observability": { "enabled": false },
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false
}
