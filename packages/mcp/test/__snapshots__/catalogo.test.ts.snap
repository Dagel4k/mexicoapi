  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Calcula la fecha que resulta de sumar días hábiles a la fecha desde según el calendario de una autoridad (lft, cnbv o sat), contando desde el día hábil siguiente. En un plazo que corre desde una notificación, desde es el día en que surte efectos, no el día en que se hizo. Con sat, tipo_plazo es obligatorio: en declaraciones_pagos las vacaciones del SAT cuentan como hábiles (CFF, artículo 12) y en general no; con lft o cnbv no se acepta. Devuelve la fecha resultante y los días inhábiles saltados con su fuente. Las advertencias dicen lo que el cálculo no descuenta: con lft, los festivos y las suspensiones de labores del artículo 715; con declaraciones_pagos, la prórroga del quinto párrafo del artículo 12 si el resultado cae en viernes, en vacaciones del SAT o en un cierre bancario. Si el calendario no cubre el periodo responde con error; con permitir_incompleto: true calcula de todos modos y lo advierte. Es una calculadora, no asesoría legal. Consulta la API de MéxicoAPI (la pública, o la de MEXICOAPI_BASE) y, si no responde, usa los datos del paquete y lo advierte. Con MEXICOAPI_SIN_RED=1 responde con los datos del paquete, sin red.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "autoridad": {
          "description": "lft: sábados, domingos y días de descanso obligatorio del artículo 74 de la Ley Federal del Trabajo, sin los festivos del calendario oficial ni los días en que las autoridades laborales suspenden labores (artículo 715); cnbv: calendario bancario, los días en que cierran las entidades financieras (no el de la CNBV como autoridad); sat: Código Fiscal de la Federación, artículo 12, por regla, y vacaciones del SAT.",
          "enum": [
            "lft",
            "cnbv",
            "sat",
          ],
          "type": "string",
        },
        "desde": {
          "description": "Fecha de partida (AAAA-MM-DD), que no se cuenta: en un plazo que corre desde una notificación, el día en que surte efectos.",
          "format": "date",
          "type": "string",
        },
        "dias": {
          "description": "Días hábiles a sumar, de 1 a 3650.",
          "maximum": 3650,
          "minimum": 1,
          "type": "integer",
        },
        "permitir_incompleto": {
          "description": "true para calcular fuera de la cobertura del calendario, con advertencia: el resultado puede cambiar cuando se publique lo que falta.",
          "type": "boolean",
        },
        "tipo_plazo": {
          "description": "Solo con autoridad sat, y ahí obligatorio.",
          "enum": [
            "general",
            "declaraciones_pagos",
          ],
          "type": "string",
        },
      },
      "required": [
        "autoridad",
        "desde",
        "dias",
      ],
      "type": "object",
    },
    "name": "sumar_dias_habiles",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "advertencias": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "as_of": {
          "description": "Fecha de corte del dataset: la de la última actualización que lo cambió (en los datos curados, la publicación más reciente de sus fuentes). No es la fecha del valor, que va en datos.",
          "format": "date",
          "type": "string",
        },
        "datos": {
          "properties": {
            "advertencias": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
