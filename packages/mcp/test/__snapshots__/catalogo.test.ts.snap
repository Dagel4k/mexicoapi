  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
    },
    "description": "Calcula la fecha que resulta de sumar días hábiles a la fecha desde según el calendario de una autoridad (lft, cnbv o sat), contando desde el día hábil siguiente. Con sat, tipo_plazo es obligatorio: en declaraciones_pagos las vacaciones del SAT cuentan como hábiles (CFF, artículo 12) y en general no; con lft o cnbv no se acepta. Devuelve la fecha resultante y los días inhábiles saltados con su fuente. Si el calendario no cubre el periodo responde con error; con permitir_incompleto: true calcula de todos modos y lo advierte. Es una calculadora, no asesoría legal. Consulta la API de MéxicoAPI si está configurada; si no, o si no responde, usa los datos del paquete y lo advierte.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "autoridad": {
          "description": "lft: Ley Federal del Trabajo, artículo 74; cnbv: días en que cierran las entidades financieras; sat: Código Fiscal de la Federación, artículo 12, y vacaciones del SAT.",
          "enum": [
            "lft",
            "cnbv",
            "sat",
          ],
          "type": "string",
        },
        "desde": {
          "description": "Fecha de partida (AAAA-MM-DD).",
          "format": "date",
          "type": "string",
        },
        "dias": {
          "description": "Días hábiles a sumar, de 1 a 3650.",
          "maximum": 3650,
          "minimum": 1,
          "type": "integer",
        },
        "permitir_incompleto": {
          "description": "true para calcular fuera de la cobertura del calendario, con advertencia: el resultado puede cambiar cuando se publique lo que falta.",
          "type": "boolean",
        },
        "tipo_plazo": {
          "description": "Solo con autoridad sat, y ahí obligatorio.",
          "enum": [
            "general",
            "declaraciones_pagos",
          ],
          "type": "string",
        },
      },
      "required": [
        "autoridad",
        "desde",
        "dias",
      ],
      "type": "object",
    },
    "name": "sumar_dias_habiles",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "advertencias": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "as_of": {
          "description": "Fecha de los datos.",
          "format": "date",
          "type": "string",
        },
        "datos": {
          "properties": {
            "advertencias": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "autoridad": {
              "type": "string",
            },
            "desde": {
              "format": "date",
              "type": "string",
            },
            "dias": {
              "type": "integer",
            },
            "inhabiles_saltados": {
              "items": {
                "properties": {
                  "fecha": {
                    "format": "date",
                    "type": "string",
                  },
                  "fuente": {
                    "properties": {
                      "fecha_publicacion": {
                        "format": "date",
                        "type": "string",
                      },
                      "fragmento": {
                        "type": "string",
                      },
                      "nombre": {
                        "type": "string",
                      },
                      "url": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "nombre",
                      "url",
                    ],
                    "type": "object",
                  },
                  "motivo": {
                    "type": "string",
                  },
                  "tipo": {
                    "description": "descanso o vacaciones.",
                    "type": "string",
                  },
                },
                "required": [
                  "fecha",
                  "motivo",
                  "tipo",
                  "fuente",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "resultado": {
              "description": "Fecha en que vence el plazo.",
              "format": "date",
              "type": "string",
            },
          },
          "required": [
            "autoridad",
            "desde",
            "dias",
            "resultado",
            "inhabiles_saltados",
            "advertencias",
          ],
          "type": "object",
        },
        "fuente": {
          "additionalProperties": false,
          "description": "Fuente para citar el dato.",
          "properties": {
            "nombre": {
              "type": "string",
            },
            "url": {
              "type": "string",
            },
          },
          "required": [
            "nombre",
            "url",
          ],
          "type": "object",
        },
        "fuentes": {
          "description": "Todas las fuentes de la respuesta, empezando por fuente.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "nombre": {
                "type": "string",
              },
              "url": {
                "type": "string",
              },
            },
            "required": [
              "nombre",
              "url",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
        },
        "origen": {
