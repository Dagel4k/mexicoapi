  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Tipo de cambio FIX (pesos por dólar) publicado en el DOF. Con publicado, el valor que se publicó ese día; con operacion, el que aplica a una operación de ese día según el CFF, artículo 20 (el publicado el día anterior o, si ese día no hubo publicación, el último antes); sin ninguno de los dos, la publicación más reciente. Indica solo uno. Las fechas son días de la zona America/Mexico_City: para un pago de hoy, usa la fecha de hoy en esa zona; de las 18:00 a las 24:00 de esa zona, en UTC ya es el día siguiente. Consulta la API de MéxicoAPI (la pública, o la de MEXICOAPI_BASE) y, si no responde, usa los datos del paquete y lo advierte. Con MEXICOAPI_SIN_RED=1 responde con los datos del paquete, sin red. Sin red advierte en la publicación más reciente y en fechas a 7 días o menos del último dato del paquete.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operacion": {
          "description": "Fecha de la operación (AAAA-MM-DD), día de America/Mexico_City.",
          "format": "date",
          "type": "string",
        },
        "publicado": {
          "description": "Fecha de publicación en el DOF (AAAA-MM-DD), día de America/Mexico_City.",
          "format": "date",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "tipo_de_cambio_fix",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "advertencias": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "as_of": {
          "description": "Fecha de corte del dataset: la de la última actualización que lo cambió (en los datos curados, la publicación más reciente de sus fuentes). No es la fecha del valor, que va en datos.",
          "format": "date",
          "type": "string",
        },
        "datos": {
          "properties": {
            "fecha_operacion": {
              "format": "date",
              "type": "string",
            },
            "fecha_publicacion": {
              "description": "Día de la publicación en el DOF.",
              "format": "date",
              "type": "string",
            },
            "fundamento": {
              "properties": {
                "fecha_publicacion": {
                  "format": "date",
                  "type": "string",
                },
                "fragmento": {
                  "type": "string",
                },
                "nombre": {
                  "type": "string",
                },
                "url": {
                  "pattern": "^https?://",
                  "type": "string",
                },
              },
              "required": [
                "nombre",
                "url",
              ],
              "type": "object",
            },
            "valor": {
              "description": "Pesos por dólar, con 4 decimales.",
              "pattern": "^[0-9]+([.][0-9]+)?$",
              "type": "string",
            },
          },
          "required": [
            "fecha_publicacion",
            "valor",
          ],
          "type": "object",
        },
        "fuente": {
          "additionalProperties": false,
          "description": "Fuente para citar el dato.",
          "properties": {
            "nombre": {
              "type": "string",
            },
            "url": {
              "pattern": "^https?://",
              "type": "string",
            },
          },
          "required": [
            "nombre",
            "url",
          ],
          "type": "object",
        },
        "fuentes": {
          "description": "Todas las fuentes de la respuesta, empezando por fuente.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "nombre": {
                "type": "string",
              },
              "url": {
                "pattern": "^https?://",
                "type": "string",
              },
            },
            "required": [
              "nombre",
              "url",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
        },
        "origen": {
          "description": "api: la API de MéxicoAPI; paquete: los datos y las reglas del paquete mexicoapi, sin red.",
          "enum": [
            "api",
            "paquete",
          ],
          "type": "string",
        },
      },
      "required": [
        "datos",
        "as_of",
        "fuente",
        "fuentes",
        "origen",
        "advertencias",
      ],
      "type": "object",
    },
    "title": "Tipo de cambio FIX",
  },
