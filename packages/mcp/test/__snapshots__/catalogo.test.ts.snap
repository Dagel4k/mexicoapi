          "type": [
            "object",
            "array",
          ],
        },
        "fuente": {
          "additionalProperties": false,
          "description": "Fuente para citar el dato.",
          "properties": {
            "nombre": {
              "type": "string",
            },
            "url": {
              "type": "string",
            },
          },
          "required": [
            "nombre",
            "url",
          ],
          "type": "object",
        },
        "fuentes": {
          "description": "Todas las fuentes de la respuesta, empezando por fuente.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "nombre": {
                "type": "string",
              },
              "url": {
