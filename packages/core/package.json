{
  "name": "@mexicoapi/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@mexicoapi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./curados": {
      "@mexicoapi/source": "./src/dias-habiles/curados.ts",
      "types": "./dist/dias-habiles/curados.d.ts",
      "import": "./dist/dias-habiles/curados.js"
    },
    "./constantes": {
      "@mexicoapi/source": "./src/constantes/consulta.ts",
      "types": "./dist/constantes/consulta.d.ts",
      "import": "./dist/constantes/consulta.js"
    },
    "./problemas": {
      "@mexicoapi/source": "./src/rutas/problemas.ts",
      "types": "./dist/rutas/problemas.d.ts",
      "import": "./dist/rutas/problemas.js"
    },
    "./parametros": {
      "@mexicoapi/source": "./src/rutas/parametros.ts",
      "types": "./dist/rutas/parametros.d.ts",
      "import": "./dist/rutas/parametros.js"
    },
    "./combinaciones": {
      "@mexicoapi/source": "./src/rutas/combinaciones.ts",
      "types": "./dist/rutas/combinaciones.d.ts",
      "import": "./dist/rutas/combinaciones.js"
    },
    "./rutas": {
      "@mexicoapi/source": "./src/rutas/index.ts",
      "types": "./dist/rutas/index.d.ts",
      "import": "./dist/rutas/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && tsc -p tsconfig.build.json --declaration false --removeComments"
  }
}
