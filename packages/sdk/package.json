{
  "name": "mexicoapi",
  "version": "0.1.0",
  "description": "Validadores, datos oficiales y cliente HTTP de MéxicoAPI: CLABE, RFC, CURP, NSS, días hábiles, FIX, UDIS, UMA, salario mínimo e ISR. Con CLI y descarga local de los códigos postales de SEPOMEX. Sin dependencias.",
  "keywords": [
    "méxico",
    "mexico",
    "clabe",
    "rfc",
    "curp",
    "nss",
    "días hábiles",
    "fix",
    "udis",
    "uma",
    "isr",
    "salario mínimo",
    "sepomex",
    "código postal",
    "inegi",
    "banxico",
    "sat",
    "cnbv",
    "cliente http",
    "cli"
  ],
  "homepage": "https://github.com/Dagel4k/mexicoapi/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/Dagel4k/mexicoapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dagel4k/mexicoapi.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "author": "Daniel Pereda (https://github.com/Dagel4k)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mexicoapi": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cliente": {
      "types": "./dist/cliente/index.d.ts",
      "import": "./dist/cliente/index.js",
      "default": "./dist/cliente/index.js"
    },
    "./datos": {
      "types": "./dist/datos/index.d.ts",
      "import": "./dist/datos/index.js",
      "default": "./dist/datos/index.js"
    },
    "./datos/fix": {
      "types": "./dist/datos/fix.d.ts",
      "import": "./dist/datos/fix.js",
      "default": "./dist/datos/fix.js"
    },
    "./datos/udis": {
      "types": "./dist/datos/udis.d.ts",
      "import": "./dist/datos/udis.js",
      "default": "./dist/datos/udis.js"
    },
    "./datos/calendarios": {
      "types": "./dist/datos/calendarios.d.ts",
      "import": "./dist/datos/calendarios.js",
      "default": "./dist/datos/calendarios.js"
    },
    "./datos/constantes": {
      "types": "./dist/datos/constantes.d.ts",
      "import": "./dist/datos/constantes.js",
      "default": "./dist/datos/constantes.js"
    },
    "./sepomex": {
      "types": "./dist/sepomex/index.d.ts",
      "import": "./dist/sepomex/index.js",
      "default": "./dist/sepomex/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "build": "node scripts/empaquetar.ts preparar && tsc -p tsconfig.build.json && tsc -p tsconfig.build-node.json && node scripts/empaquetar.ts nucleo && node scripts/datos.ts",
    "prepack": "node scripts/publicable.ts",
    "test:paquete": "vitest run --config vitest.paquete.config.ts",
    "test:integracion": "vitest run --config vitest.integracion.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@mexicoapi/core": "workspace:*",
    "wrangler": "4.149.0"
  }
}
